{
  "bookId": "PSA",
  "chapter": 100,
  "bookEnglish": "Psalms",
  "bookChineseSimplified": "诗篇",
  "bookChineseTraditional": "詩篇",
  "verses": [
    {
      "verse": "1",
      "en": {
        "text": "Shout for joy to the LORD, all you lands!",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "普天下当向耶和华欢呼！",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "普天下當向耶和華歡呼！",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "2",
      "en": {
        "text": "Serve the LORD with gladness. before his presence with singing.",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "你们当乐意事奉耶和华，",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "你們當樂意事奉耶和華，",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "3",
      "en": {
        "text": "Know that the LORD, he is God. It is he who has made us, and we are his. We are his people, and the sheep of his pasture.",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "你们当晓得耶和华是 神！",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "你們當曉得耶和華是上帝！",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "4",
      "en": {
        "text": "Enter into his gates with thanksgiving, and into his courts with praise. Give thanks to him, and bless his name.",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "当称谢进入他的门；",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "當稱謝進入他的門；",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "5",
      "en": {
        "text": "For the LORD is good. His loving kindness endures forever, his faithfulness to all generations.",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "因为耶和华本为善。",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "因為耶和華本為善。",
        "footnotes": [],
        "crossReferences": []
      }
    }
  ]
}