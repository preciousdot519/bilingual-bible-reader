{
  "bookId": "PSA",
  "chapter": 11,
  "bookEnglish": "Psalms",
  "bookChineseSimplified": "诗篇",
  "bookChineseTraditional": "詩篇",
  "verses": [
    {
      "verse": "1",
      "en": {
        "text": "In the LORD, I take refuge. you say to my soul, “Flee as a bird to your mountain”?",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "我是投靠耶和华；",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "我是投靠耶和華；",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "2",
      "en": {
        "text": "For, behold, the wicked bend their bows. They set their arrows on the strings, that they may shoot in darkness at the upright in heart.",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "看哪，恶人弯弓，把箭搭在弦上，",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "看哪，惡人彎弓，把箭搭在弦上，",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "3",
      "en": {
        "text": "If the foundations are destroyed, what can the righteous do?",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "根基若毁坏，",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "根基若毀壞，",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "4",
      "en": {
        "text": "The LORD is in his holy temple. The LORD is on his throne in heaven. His eyes observe. His eyes examine the children of men.",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "耶和华在他的圣殿里；",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "耶和華在他的聖殿裏；",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "5",
      "en": {
        "text": "The LORD examines the righteous, but his soul hates the wicked and him who loves violence.",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "耶和华试验义人；",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "耶和華試驗義人；",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "6",
      "en": {
        "text": "On the wicked he will rain blazing coals; sulfur, and scorching wind shall be the portion of their cup.",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "他要向恶人密布网罗；",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "他要向惡人密布網羅；",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "7",
      "en": {
        "text": "For the LORD is righteous. He loves righteousness. The upright shall see his face.",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "因为耶和华是公义的，他喜爱公义；",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "因為耶和華是公義的，他喜愛公義；",
        "footnotes": [],
        "crossReferences": []
      }
    }
  ]
}