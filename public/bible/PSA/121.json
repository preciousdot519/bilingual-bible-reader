{
  "bookId": "PSA",
  "chapter": 121,
  "bookEnglish": "Psalms",
  "bookChineseSimplified": "诗篇",
  "bookChineseTraditional": "詩篇",
  "verses": [
    {
      "verse": "1",
      "en": {
        "text": "I will lift up my eyes to the hills. my help come from?",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "我要向山举目；",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "我要向山舉目；",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "2",
      "en": {
        "text": "My help comes from the LORD, who made heaven and earth.",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "我的帮助",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "我的幫助",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "3",
      "en": {
        "text": "He will not allow your foot to be moved. He who keeps you will not slumber.",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "他必不叫你的脚摇动；",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "他必不叫你的腳搖動；",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "4",
      "en": {
        "text": "Behold, he who keeps Israel will neither slumber nor sleep.",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "保护的，",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "保護的，",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "5",
      "en": {
        "text": "The LORD is your keeper. The LORD is your shade on your right hand.",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "保护你的是耶和华；",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "保護你的是耶和華；",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "6",
      "en": {
        "text": "The sun will not harm you by day, nor the moon by night.",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "白日，太阳必不伤你；",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "白日，太陽必不傷你；",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "7",
      "en": {
        "text": "The LORD will keep you from all evil. He will keep your soul.",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "耶和华要保护你，免受一切的灾害；",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "耶和華要保護你，免受一切的災害；",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "8",
      "en": {
        "text": "The LORD will keep your going out and your coming in, from this time forward, and forever more.",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "你出你入，耶和华要保护你，",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "你出你入，耶和華要保護你，",
        "footnotes": [],
        "crossReferences": []
      }
    }
  ]
}