{
  "bookId": "PSA",
  "chapter": 128,
  "bookEnglish": "Psalms",
  "bookChineseSimplified": "诗篇",
  "bookChineseTraditional": "詩篇",
  "verses": [
    {
      "verse": "1",
      "en": {
        "text": "Blessed is everyone who fears the LORD, who walks in his ways.",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "凡敬畏耶和华、",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "凡敬畏耶和華、",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "2",
      "en": {
        "text": "For you will eat the labor of your hands. You will be happy, and it will be well with you.",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "你要吃劳碌得来的；",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "你要吃勞碌得來的；",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "3",
      "en": {
        "text": "Your wife will be as a fruitful vine in the innermost parts of your house, your children like olive shoots around your table.",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "你妻子在你的内室，好像多结果子的葡萄树；",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "你妻子在你的內室，好像多結果子的葡萄樹；",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "4",
      "en": {
        "text": "Behold, this is how the man who fears the LORD is blessed.",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "看哪，敬畏耶和华的人必要这样蒙福！",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "看哪，敬畏耶和華的人必要這樣蒙福！",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "5",
      "en": {
        "text": "May the LORD bless you out of Zion, and may you see the good of Jerusalem all the days of your life.",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "愿耶和华从赐福给你！ 的好处！",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "願耶和華從賜福給你！ 的好處！",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "6",
      "en": {
        "text": "Yes, may you see your children’s children. Peace be upon Israel.",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "愿你看见你儿女的儿女！ ！",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "願你看見你兒女的兒女！ ！",
        "footnotes": [],
        "crossReferences": []
      }
    }
  ]
}