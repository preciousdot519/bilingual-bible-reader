{
  "bookId": "PSA",
  "chapter": 129,
  "bookEnglish": "Psalms",
  "bookChineseSimplified": "诗篇",
  "bookChineseTraditional": "詩篇",
  "verses": [
    {
      "verse": "1",
      "en": {
        "text": "Many times they have afflicted me from my youth up. Let Israel now say:",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "当说：从我幼年以来，",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "當說：從我幼年以來，",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "2",
      "en": {
        "text": "many times they have afflicted me from my youth up, yet they have not prevailed against me.",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "从我幼年以来，敌人屡次苦害我，",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "從我幼年以來，敵人屢次苦害我，",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "3",
      "en": {
        "text": "The plowers plowed on my back. They made their furrows long.",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "扶犁的在我背上扶犁而耕，",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "扶犂的在我背上扶犂而耕，",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "4",
      "en": {
        "text": "The LORD is righteous. He has cut apart the cords of the wicked.",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "耶和华是公义的；",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "耶和華是公義的；",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "5",
      "en": {
        "text": "Let them be disappointed and turned backward, all those who hate Zion.",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "愿恨恶的都蒙羞退后！",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "願恨惡的都蒙羞退後！",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "6",
      "en": {
        "text": "Let them be as the grass on the housetops, which withers before it grows up,",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "愿他们像房顶上的草，",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "願他們像房頂上的草，",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "7",
      "en": {
        "text": "with which the reaper doesn’t fill his hand, nor he who binds sheaves, his bosom.",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "收割的不够一把，",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "收割的不夠一把，",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "8",
      "en": {
        "text": "Neither do those who go by say, The blessing of the LORD be on you. We bless you in the LORD’s name.”",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "过路的也不说：",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "過路的也不說：",
        "footnotes": [],
        "crossReferences": []
      }
    }
  ]
}