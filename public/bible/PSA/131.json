  "verses": [
    {
      "verse": "1",
      "en": {
        "text": "LORD, my heart isn’t arrogant, nor my eyes lofty; nor do I concern myself with great matters, or things too wonderful for me.",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "耶和华啊，我的心不狂傲，",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "耶和華啊，我的心不狂傲，",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "2",
      "en": {
        "text": "Surely I have stilled and quieted my soul, like a weaned child with his mother, like a weaned child is my soul within me.",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "我的心平稳安静，",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "我的心平穩安靜，",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "3",
      "en": {
        "text": "Israel, hope in the LORD, from this time forward and forever more.",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "啊，你当仰望耶和华，",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "啊，你當仰望耶和華，",
        "footnotes": [],
        "crossReferences": []
      }
    }
  ]
