{
  "bookId": "PSA",
  "chapter": 142,
  "bookEnglish": "Psalms",
  "bookChineseSimplified": "诗篇",
  "bookChineseTraditional": "詩篇",
  "verses": [
    {
      "verse": "1",
      "en": {
        "text": "I cry with my voice to the LORD. With my voice, I ask the LORD for mercy.",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "我发声哀告耶和华，",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "我發聲哀告耶和華，",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "2",
      "en": {
        "text": "I pour out my complaint before him. I tell him my troubles.",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "我在他面前吐露我的苦情，",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "我在他面前吐露我的苦情，",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "3",
      "en": {
        "text": "When my spirit was overwhelmed within me, you knew my route. On the path in which I walk, they have hidden a snare for me.",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "我的灵在我里面发昏的时候，",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "我的靈在我裏面發昏的時候，",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "4",
      "en": {
        "text": "Look on my right, and see; for there is no one who is concerned for me. has fled from me. No one cares for my soul.",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "求你向我右边观看，",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "求你向我右邊觀看，",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "5",
      "en": {
        "text": "I cried to you, LORD. I said, “You are my refuge, my portion in the land of the living.”",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "耶和华啊，我曾向你哀求。",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "耶和華啊，我曾向你哀求。",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "6",
      "en": {
        "text": "Listen to my cry, for I am in desperate need. me from my persecutors, for they are too strong for me.",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "求你侧耳听我的呼求，",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "求你側耳聽我的呼求，",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "7",
      "en": {
        "text": "Bring my soul out of prison, that I may give thanks to your name. The righteous will surround me, for you will be good to me.",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "求你领我出离被囚之地，",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "求你領我出離被囚之地，",
        "footnotes": [],
        "crossReferences": []
      }
    }
  ]
}