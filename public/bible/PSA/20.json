{
  "bookId": "PSA",
  "chapter": 20,
  "bookEnglish": "Psalms",
  "bookChineseSimplified": "诗篇",
  "bookChineseTraditional": "詩篇",
  "verses": [
    {
      "verse": "1",
      "en": {
        "text": "May the LORD answer you in the day of trouble. May the name of the God of Jacob set you up on high,",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "愿耶和华在你遭难的日子应允你； 神的高举你。",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "願耶和華在你遭難的日子應允你； 上帝的高舉你。",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "2",
      "en": {
        "text": "send you help from the sanctuary, grant you support from Zion,",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "愿他从圣所救助你， 坚固你，",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "願他從聖所救助你， 堅固你，",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "3",
      "en": {
        "text": "remember all your offerings, and accept your burned sacrifice.",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "记念你的一切供献，",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "記念你的一切供獻，",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "4",
      "en": {
        "text": "May he grant you your heart’s desire, and fulfill all your counsel.",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "将你心所愿的赐给你，",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "將你心所願的賜給你，",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "5",
      "en": {
        "text": "We will triumph in your salvation. In the name of our God, we will set up our banners. May the LORD grant all your requests.",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "我们要因你的救恩夸胜，",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "我們要因你的救恩誇勝，",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "6",
      "en": {
        "text": "Now I know that the LORD saves his anointed. He will answer him from his holy heaven, with the saving strength of his right hand.",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "现在我知道耶和华救护他的受膏者，",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "現在我知道耶和華救護他的受膏者，",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "7",
      "en": {
        "text": "Some trust in chariots, and some in horses, but we trust in the name of the LORD our God.",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "有人车，有人马，",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "有人車，有人馬，",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "8",
      "en": {
        "text": "They are bowed down and fallen, but we rise up, and stand upright.",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "他们都屈身仆倒，",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "他們都屈身仆倒，",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "9",
      "en": {
        "text": "Save, LORD! the King answer us when we call!",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "求耶和华施行拯救；",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "求耶和華施行拯救；",
        "footnotes": [],
        "crossReferences": []
      }
    }
  ]
}