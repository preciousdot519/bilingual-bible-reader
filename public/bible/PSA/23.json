{
  "bookId": "PSA",
  "chapter": 23,
  "bookEnglish": "Psalms",
  "bookChineseSimplified": "诗篇",
  "bookChineseTraditional": "詩篇",
  "verses": [
    {
      "verse": "1",
      "en": {
        "text": "The LORD is my shepherd; I shall lack nothing.",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "耶和华是我的牧者，",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "耶和華是我的牧者，",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "2",
      "en": {
        "text": "He makes me lie down in green pastures. He leads me beside still waters.",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "他使我躺卧在青草地上，",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "他使我躺臥在青草地上，",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "3",
      "en": {
        "text": "He restores my soul. He guides me in the paths of righteousness for his name’s sake.",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "他使我的灵魂苏醒，",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "他使我的靈魂甦醒，",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "4",
      "en": {
        "text": "Even though I walk through the valley of the shadow of death, I will fear no evil, for you are with me. Your rod and your staff, they comfort me.",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "我虽然行过死荫的谷，",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "我雖然行過死蔭的谷，",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "5",
      "en": {
        "text": "You prepare a table before me in the presence of my enemies. You anoint my head with oil. My cup runs over.",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "在我敌人面前，你为我摆设筵席； 杯满溢。",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "在我敵人面前，你為我擺設筵席； 杯滿溢。",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "6",
      "en": {
        "text": "Surely goodness and loving kindness shall follow me all the days of my life, and I will dwell in the LORD’s house forever.",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "我一生一世必有恩惠慈爱随着我；",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "我一生一世必有恩惠慈愛隨着我；",
        "footnotes": [],
        "crossReferences": []
      }
    }
  ]
}