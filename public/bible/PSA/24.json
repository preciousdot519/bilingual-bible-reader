{
  "bookId": "PSA",
  "chapter": 24,
  "bookEnglish": "Psalms",
  "bookChineseSimplified": "诗篇",
  "bookChineseTraditional": "詩篇",
  "verses": [
    {
      "verse": "1",
      "en": {
        "text": "The earth is the LORD’s, with its fullness; the world, and those who dwell in it.",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "地和其中所充满的，",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "地和其中所充滿的，",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "2",
      "en": {
        "text": "For he has founded it on the seas, and established it on the floods.",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "他把地建立在海上，",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "他把地建立在海上，",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "3",
      "en": {
        "text": "Who may ascend to the LORD’s hill? Who may stand in his holy place?",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "谁能登耶和华的山？",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "誰能登耶和華的山？",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "4",
      "en": {
        "text": "He who has clean hands and a pure heart; who has not lifted up his soul to falsehood, and has not sworn deceitfully.",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "就是手洁心清，不向虚妄，",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "就是手潔心清，不向虛妄，",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "5",
      "en": {
        "text": "He shall receive a blessing from the LORD, righteousness from the God of his salvation.",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "他必蒙耶和华赐福，",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "他必蒙耶和華賜福，",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "6",
      "en": {
        "text": "This is the generation of those who seek Him, who seek your face—even Jacob. Selah.",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "这是寻求耶和华的族类， 。",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "這是尋求耶和華的族類， 。",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "7",
      "en": {
        "text": "Lift up your heads, you gates! Be lifted up, you everlasting doors, and the King of glory will come in.",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "众城门哪，你们要抬起头来！",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "眾城門哪，你們要抬起頭來！",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "8",
      "en": {
        "text": "Who is the King of glory? The LORD strong and mighty, the LORD mighty in battle.",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "荣耀的王是谁呢？",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "榮耀的王是誰呢？",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "9",
      "en": {
        "text": "Lift up your heads, you gates; lift them up, you everlasting doors, and the King of glory will come in.",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "众城门哪，你们要抬起头来！",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "眾城門哪，你們要抬起頭來！",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "10",
      "en": {
        "text": "Who is this King of glory? The LORD of Armies is the King of glory! Selah.",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "荣耀的王是谁呢？",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "榮耀的王是誰呢？",
        "footnotes": [],
        "crossReferences": []
      }
    }
  ]
}