{
  "bookId": "PSA",
  "chapter": 26,
  "bookEnglish": "Psalms",
  "bookChineseSimplified": "诗篇",
  "bookChineseTraditional": "詩篇",
  "verses": [
    {
      "verse": "1",
      "en": {
        "text": "Judge me, LORD, for I have walked in my integrity. I have trusted also in the LORD without wavering.",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "耶和华啊，求你为我伸冤，",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "耶和華啊，求你為我伸冤，",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "2",
      "en": {
        "text": "Examine me, LORD, and prove me. Try my heart and my mind.",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "耶和华啊，求你察看我，试验我，",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "耶和華啊，求你察看我，試驗我，",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "3",
      "en": {
        "text": "For your loving kindness is before my eyes. I have walked in your truth.",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "因为你的慈爱常在我眼前，",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "因為你的慈愛常在我眼前，",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "4",
      "en": {
        "text": "I have not sat with deceitful men, neither will I go in with hypocrites.",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "我没有和虚谎人同坐，",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "我沒有和虛謊人同坐，",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "5",
      "en": {
        "text": "I hate the assembly of evildoers, and will not sit with the wicked.",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "我恨恶恶人的会，",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "我恨惡惡人的會，",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "6",
      "en": {
        "text": "I will wash my hands in innocence, so I will go about your altar, LORD,",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "耶和华啊，我要洗手表明无辜，",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "耶和華啊，我要洗手表明無辜，",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "7",
      "en": {
        "text": "that I may make the voice of thanksgiving to be heard and tell of all your wondrous deeds.",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "我好发称谢的声音，",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "我好發稱謝的聲音，",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "8",
      "en": {
        "text": "LORD, I love the habitation of your house, the place where your glory dwells.",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "耶和华啊，我喜爱你所住的殿",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "耶和華啊，我喜愛你所住的殿",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "9",
      "en": {
        "text": "Don’t gather my soul with sinners, my life with bloodthirsty men",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "不要把我的灵魂和罪人一同除掉；",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "不要把我的靈魂和罪人一同除掉；",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "10",
      "en": {
        "text": "in whose hands is wickedness; their right hand is full of bribes.",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "他们的手中有奸恶，",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "他們的手中有奸惡，",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "11",
      "en": {
        "text": "But as for me, I will walk in my integrity. Redeem me, and be merciful to me.",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "至于我，却要行事纯全；",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "至於我，卻要行事純全；",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "12",
      "en": {
        "text": "My foot stands in an even place. In the congregations I will bless the LORD.",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "我的脚站在平坦地方；",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "我的腳站在平坦地方；",
        "footnotes": [],
        "crossReferences": []
      }
    }
  ]
}