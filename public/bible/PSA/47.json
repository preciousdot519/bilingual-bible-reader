{
  "bookId": "PSA",
  "chapter": 47,
  "bookEnglish": "Psalms",
  "bookChineseSimplified": "诗篇",
  "bookChineseTraditional": "詩篇",
  "verses": [
    {
      "verse": "1",
      "en": {
        "text": "Oh clap your hands, all you nations. to God with the voice of triumph!",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "万民哪，你们都要拍掌！",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "萬民哪，你們都要拍掌！",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "2",
      "en": {
        "text": "For the LORD Most High is awesome. He is a great King over all the earth.",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "因为耶和华至高者是可畏的；",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "因為耶和華至高者是可畏的；",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "3",
      "en": {
        "text": "He subdues nations under us, and peoples under our feet.",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "他叫万民服在我们以下，",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "他叫萬民服在我們以下，",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "4",
      "en": {
        "text": "He chooses our inheritance for us, the glory of Jacob whom he loved.",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "他为我们选择产业， 的荣耀。",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "他為我們選擇產業， 的榮耀。",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "5",
      "en": {
        "text": "God has gone up with a shout, the LORD with the sound of a trumpet.",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "神上升，有喊声相送；",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "上帝上升，有喊聲相送；",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "6",
      "en": {
        "text": "Sing praises to God! Sing praises! praises to our King! Sing praises!",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "你们要向 神歌颂，歌颂！",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "你們要向上帝歌頌，歌頌！",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "7",
      "en": {
        "text": "For God is the King of all the earth. Sing praises with understanding.",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "因为 神是全地的王；",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "因為上帝是全地的王；",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "8",
      "en": {
        "text": "God reigns over the nations. on his holy throne.",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "神作王治理万国；",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "上帝作王治理萬國；",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "9",
      "en": {
        "text": "The princes of the peoples are gathered together, the people of the God of Abraham. For the shields of the earth belong to God. He is greatly exalted!",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "列邦的君王聚集要作之 神的民。",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "列邦的君王聚集要作之上帝的民。",
        "footnotes": [],
        "crossReferences": []
      }
    }
  ]
}