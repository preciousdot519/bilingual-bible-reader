{
  "bookId": "PSA",
  "chapter": 54,
  "bookEnglish": "Psalms",
  "bookChineseSimplified": "诗篇",
  "bookChineseTraditional": "詩篇",
  "verses": [
    {
      "verse": "1",
      "en": {
        "text": "Save me, God, by your name. in your might.",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "神啊，求你以你的名救我，",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "上帝啊，求你以你的名救我，",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "2",
      "en": {
        "text": "Hear my prayer, God. to the words of my mouth.",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "神啊，求你听我的祷告，",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "上帝啊，求你聽我的禱告，",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "3",
      "en": {
        "text": "For strangers have risen up against me. men have sought after my soul. They haven’t set God before them.",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "因为，外人起来攻击我，",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "因為，外人起來攻擊我，",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "4",
      "en": {
        "text": "Behold, God is my helper. The Lord is the one who sustains my soul.",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "神是帮助我的，是扶持我命的。",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "上帝是幫助我的，是扶持我命的。",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "5",
      "en": {
        "text": "He will repay the evil to my enemies. them in your truth.",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "他要报应我仇敌所行的恶；",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "他要報應我仇敵所行的惡；",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "6",
      "en": {
        "text": "With a free will offering, I will sacrifice to you. I will give thanks to your name, LORD, for it is good.",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "我要把甘心祭献给你。",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "我要把甘心祭獻給你。",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "7",
      "en": {
        "text": "For he has delivered me out of all trouble. My eye has seen triumph over my enemies.",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "他从一切的急难中把我救出来； 。",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "他從一切的急難中把我救出來； 。",
        "footnotes": [],
        "crossReferences": []
      }
    }
  ]
}