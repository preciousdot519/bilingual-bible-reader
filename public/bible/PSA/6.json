{
  "bookId": "PSA",
  "chapter": 6,
  "bookEnglish": "Psalms",
  "bookChineseSimplified": "诗篇",
  "bookChineseTraditional": "詩篇",
  "verses": [
    {
      "verse": "1",
      "en": {
        "text": "LORD, don’t rebuke me in your anger, me in your wrath.",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "耶和华啊，求你不要在怒中责备我，",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "耶和華啊，求你不要在怒中責備我，",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "2",
      "en": {
        "text": "Have mercy on me, LORD, for I am faint. LORD, heal me, for my bones are troubled.",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "耶和华啊，求你可怜我，因为我软弱。",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "耶和華啊，求你可憐我，因為我軟弱。",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "3",
      "en": {
        "text": "My soul is also in great anguish. But you, LORD—how long?",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "我心也大大地惊惶。 呢？",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "我心也大大地驚惶。 呢？",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "4",
      "en": {
        "text": "Return, LORD. Deliver my soul, and save me for your loving kindness’ sake.",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "耶和华啊，求你转回搭救我！",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "耶和華啊，求你轉回搭救我！",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "5",
      "en": {
        "text": "For in death there is no memory of you. In Sheol, who shall give you thanks?",
        "footnotes": [
          {
            "id": "f1",
            "text": "6:5 Sheol is the place of the dead."
          }
        ],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "因为，在死地无人记念你，",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "因為，在死地無人記念你，",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "6",
      "en": {
        "text": "I am weary with my groaning. Every night I flood my bed. I drench my couch with my tears.",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "我因唉哼而困乏；",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "我因唉哼而困乏；",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "7",
      "en": {
        "text": "My eye wastes away because of grief. It grows old because of all my adversaries.",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "我因忧愁眼睛干瘪，",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "我因憂愁眼睛乾癟，",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "8",
      "en": {
        "text": "Depart from me, all you workers of iniquity, for the LORD has heard the voice of my weeping.",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "你们一切作孽的人，离开我吧！",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "你們一切作孽的人，離開我吧！",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "9",
      "en": {
        "text": "The LORD has heard my supplication. The LORD accepts my prayer.",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "耶和华听了我的恳求；",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "耶和華聽了我的懇求；",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "10",
      "en": {
        "text": "May all my enemies be ashamed and dismayed. They shall turn back, they shall be disgraced suddenly.",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "我的一切仇敌都必羞愧，大大惊惶；",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "我的一切仇敵都必羞愧，大大驚惶；",
        "footnotes": [],
        "crossReferences": []
      }
    }
  ]
}