{
  "bookId": "PSA",
  "chapter": 61,
  "bookEnglish": "Psalms",
  "bookChineseSimplified": "诗篇",
  "bookChineseTraditional": "詩篇",
  "verses": [
    {
      "verse": "1",
      "en": {
        "text": "Hear my cry, God. to my prayer.",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "神啊，求你听我的呼求，",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "上帝啊，求你聽我的呼求，",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "2",
      "en": {
        "text": "From the end of the earth, I will call to you when my heart is overwhelmed. me to the rock that is higher than I.",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "我心里发昏的时候，",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "我心裏發昏的時候，",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "3",
      "en": {
        "text": "For you have been a refuge for me, a strong tower from the enemy.",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "因为你作过我的避难所，",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "因為你作過我的避難所，",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "4",
      "en": {
        "text": "I will dwell in your tent forever. I will take refuge in the shelter of your wings.",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "我要永远住在你的帐幕里！",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "我要永遠住在你的帳幕裏！",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "5",
      "en": {
        "text": "For you, God, have heard my vows. You have given me the heritage of those who fear your name.",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "神啊，你原是听了我所许的愿；",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "上帝啊，你原是聽了我所許的願；",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "6",
      "en": {
        "text": "You will prolong the king’s life. His years will be for generations.",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "你要加添王的寿数；",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "你要加添王的壽數；",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "7",
      "en": {
        "text": "He shall be enthroned in God’s presence forever. your loving kindness and truth, that they may preserve him.",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "他必永远坐在 神面前；",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "他必永遠坐在上帝面前；",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "8",
      "en": {
        "text": "So I will sing praise to your name forever, that I may fulfill my vows daily.",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "这样，我要歌颂你的名，直到永远，",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "這樣，我要歌頌你的名，直到永遠，",
        "footnotes": [],
        "crossReferences": []
      }
    }
  ]
}