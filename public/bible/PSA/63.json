{
  "bookId": "PSA",
  "chapter": 63,
  "bookEnglish": "Psalms",
  "bookChineseSimplified": "诗篇",
  "bookChineseTraditional": "詩篇",
  "verses": [
    {
      "verse": "1",
      "en": {
        "text": "God, you are my God. I will earnestly seek you. My soul thirsts for you. My flesh longs for you, in a dry and weary land, where there is no water.",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "神啊，你是我的 神，",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "上帝啊，你是我的上帝，",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "2",
      "en": {
        "text": "So I have seen you in the sanctuary, your power and your glory.",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "我在圣所中曾如此瞻仰你，",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "我在聖所中曾如此瞻仰你，",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "3",
      "en": {
        "text": "Because your loving kindness is better than life, my lips shall praise you.",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "因你的慈爱比生命更好，",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "因你的慈愛比生命更好，",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "4",
      "en": {
        "text": "So I will bless you while I live. I will lift up my hands in your name.",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "我还活的时候要这样称颂你；",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "我還活的時候要這樣稱頌你；",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "5",
      "en": {
        "text": "My soul shall be satisfied as with the richest food. My mouth shall praise you with joyful lips,",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "5-6",
      "en": {
        "text": "",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "我在床上记念你，",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "我在床上記念你，",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "6",
      "en": {
        "text": "when I remember you on my bed, and think about you in the night watches.",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "7",
      "en": {
        "text": "For you have been my help. I will rejoice in the shadow of your wings.",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "因为你曾帮助我，",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "因為你曾幫助我，",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "8",
      "en": {
        "text": "My soul stays close to you. Your right hand holds me up.",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "我心紧紧地跟随你；",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "我心緊緊地跟隨你；",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "9",
      "en": {
        "text": "But those who seek my soul to destroy it shall go into the lower parts of the earth.",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "但那些寻索要灭我命的人",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "但那些尋索要滅我命的人",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "10",
      "en": {
        "text": "They shall be given over to the power of the sword. They shall be jackal food.",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "他们必被刀剑所杀，",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "他們必被刀劍所殺，",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "11",
      "en": {
        "text": "But the king shall rejoice in God. by him will praise him, for the mouth of those who speak lies shall be silenced.",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "但是王必因 神欢喜。",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "但是王必因上帝歡喜。",
        "footnotes": [],
        "crossReferences": []
      }
    }
  ]
}