      },
      "zhTraditional": {
        "text": "上帝啊，願列邦稱讚你！",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "6",
      "en": {
        "text": "The earth has yielded its increase. our own God, will bless us.",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "地已经出了土产；",
        "footnotes": [],
        "crossReferences": []
