  "verses": [
    {
      "verse": "1",
      "en": {
        "text": "May God be merciful to us, bless us, to shine on us.",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "愿 神怜悯我们，赐福与我们，",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "願上帝憐憫我們，賜福與我們，",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "2",
      "en": {
        "text": "That your way may be known on earth, and your salvation among all nations,",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "好叫世界得知你的道路，",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "好叫世界得知你的道路，",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "3",
      "en": {
        "text": "let the peoples praise you, God. all the peoples praise you.",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "神啊，愿列邦称赞你！",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "上帝啊，願列邦稱讚你！",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "4",
      "en": {
        "text": "Oh let the nations be glad and sing for joy, for you will judge the peoples with equity, and govern the nations on earth.",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "愿万国都快乐欢呼；",
        "footnotes": [],
        "crossReferences": []
      },
      "zhTraditional": {
        "text": "願萬國都快樂歡呼；",
        "footnotes": [],
        "crossReferences": []
      }
    },
    {
      "verse": "5",
      "en": {
        "text": "Let the peoples praise you, God. Let all the peoples praise you.",
        "footnotes": [],
        "crossReferences": []
      },
      "zhSimplified": {
        "text": "神啊，愿列邦称赞你！",
        "footnotes": [],
